<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xuan.erp.iam.infrastructure.persistence.mapper.IamMenuPersistenceMapper">

    <resultMap id="IamMenuRecordMap" type="com.xuan.erp.iam.infrastructure.persistence.entity.IamMenuRecord">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="code" javaType="java.lang.String"/>
            <arg column="parent_id" javaType="java.lang.Long"/>
            <arg column="title" javaType="java.lang.String"/>
            <arg column="i18n_key" javaType="java.lang.String"/>
            <arg column="path" javaType="java.lang.String"/>
            <arg column="icon" javaType="java.lang.String"/>
            <arg column="permission_code" javaType="java.lang.String"/>
            <arg column="sort_no" javaType="java.lang.Integer"/>
            <arg column="is_enabled" javaType="java.lang.Boolean"/>
            <arg column="created_by" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.OffsetDateTime"/>
            <arg column="updated_by" javaType="java.lang.String"/>
            <arg column="updated_at" javaType="java.time.OffsetDateTime"/>
            <arg column="deleted_by" javaType="java.lang.String"/>
            <arg column="delete_reason" javaType="java.lang.String"/>
            <arg column="deleted_at" javaType="java.time.OffsetDateTime"/>
        </constructor>
    </resultMap>

    <select id="findByCode" resultMap="IamMenuRecordMap">
        SELECT id, code, parent_id, title, i18n_key, path, icon, permission_code, sort_no, is_enabled,
               created_by, created_at, updated_by, updated_at, deleted_by, delete_reason, deleted_at
        FROM iam_menu
        WHERE code = #{code}
          AND deleted_at IS NULL
        LIMIT 1
    </select>

    <select id="findActiveMenus" resultMap="IamMenuRecordMap">
        SELECT id, code, parent_id, title, i18n_key, path, icon, permission_code, sort_no, is_enabled,
               created_by, created_at, updated_by, updated_at, deleted_by, delete_reason, deleted_at
        FROM iam_menu
        WHERE deleted_at IS NULL
        ORDER BY sort_no, id
    </select>
</mapper>
